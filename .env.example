# Copy this file to .env for local development and replace the placeholders.
# On Render, add these values under Environment instead of uploading a .env file.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/quickservice?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ADMIN_EMAIL=choose-your-admin-email
ADMIN_PASSWORD=choose-a-strong-admin-password
